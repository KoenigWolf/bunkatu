{
  "compilerOptions": {
    // =============================
    // コンパイラ設定
    // =============================

    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,

    // 型の厳密なチェックを有効にする（バグを減らす）
    "strict": true,

    "noEmit": true,
    "esModuleInterop": true,

    // =============================
    // モジュール設定
    // =============================

    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",

    // =============================
    // ビルド & 開発パフォーマンス
    // =============================

    "incremental": true,

    // =============================
    // Next.js & TypeScript 設定
    // =============================

    "plugins": [
      {
        "name": "next"
      }
    ],

    "paths": {
      "@/*": ["./src/*"]
    },

    // 大文字・小文字の違いによるバグを防ぐ
    "forceConsistentCasingInFileNames": true
  },

  // =============================
  // 型チェック対象のファイル
  // =============================

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],

  // =============================
  // 型チェックから除外するフォルダ
  // =============================

  "exclude": [
    "node_modules"
  ]
}
